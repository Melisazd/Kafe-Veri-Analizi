
BÖLÜM 3: CASE WHEN (ŞARTLI MANTIK VE SEGMENTASYON) İLE ANALİZ Bu bölümde, ham verileri iş kurallarına göre anlamlı segmentlere 
ve raporlama etiketlerine dönüştürmek için CASE WHEN yapısı çalışılmıştır.

SENARYO 1: Ürün ve Hammadde Stok Durum Analizi (JOIN + CASE WHEN)

SELECT 
    Urunler.UrunID,
    Urunler.UrunAdi,
    Hammaddeler.MinStokMiktari,
    CASE 
        WHEN Hammaddeler.MinStokMiktari < 5 THEN 'stok 5 in altında'
        WHEN Hammaddeler.MinStokMiktari >= 5 AND Hammaddeler.MinStokMiktari <= 20 THEN 'normal seviye'
        ELSE 'güvenli stok hacmi'
    END AS [stok durumu]
FROM dbo.Urunler
INNER JOIN dbo.Hammaddeler ON Urunler.UrunID = Hammaddeler.HammaddeId;

SENARYO 2: Personel Maaş ve Kıdem Analizi (Tek Tablo Üzerinde CASE WHEN)

SELECT 
    PersonelID, 
    Pozisyon, 
    Maas,
    CASE 
        WHEN Maas < 25000 THEN 'Asistan / Junior'
        WHEN Maas >= 25000 AND Maas <= 60000 THEN 'Uzman / Mid-Level'
        ELSE 'Yönetici / Senior'
    END AS [KidemDurumu]
FROM dbo.Personeller;
