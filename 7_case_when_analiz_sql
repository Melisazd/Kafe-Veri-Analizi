-- BÖLÜM 3: CASE WHEN (ŞARTLI MANTIK VE SEGMENTASYON) İLE ANALİZ 

SENARYO 1: Hammadde Stok Durum Analizi (Tek Tablo Üzerinde CASE WHEN ve Segmentasyon)
-- Bağımsız hammadde tablosu üzerinden kritik stok durumlarının etiketlenmesi

SELECT 
    HammaddeID,
    HammaddeAdi,
    MinStokMiktari,
    CASE 
        WHEN MinStokMiktari < 5 THEN 'Kritik Seviye (Stok 5 Altında)'
        WHEN MinStokMiktari >= 5 AND MinStokMiktari <= 20 THEN 'Normal Seviye'
        ELSE 'Güvenli Stok Hacmi'
    END AS [Stok Durumu]
FROM dbo.Hammaddeler;


SENARYO 2: Personel Maaş ve Kıdem Analizi (Tek Tablo Üzerinde CASE WHEN)
-- Mevcut personel maaş skalasına göre unvan ve segmentasyon analizi

SELECT 
    PersonelID, 
    Pozisyon, 
    Maas,
    CASE 
        WHEN Maas < 25000 THEN 'Asistan / Junior'
        WHEN Maas >= 25000 AND Maas <= 60000 THEN 'Uzman / Mid-Level'
        ELSE 'Yönetici / Senior'
    END AS [KidemDurumu]
FROM dbo.Personeller;
